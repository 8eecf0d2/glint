{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.build/**/*",
      "!{projectRoot}/.swiftpm/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/.wrangler/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/.github/**/*"
    ],
    "desktopRelease": [
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/distribution/**/*",
      "{workspaceRoot}/docs/install.md",
      "{workspaceRoot}/docs/release-notes.md",
      "{workspaceRoot}/THIRD_PARTY_NOTICES.md",
      "{workspaceRoot}/LICENSE"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "dev": {
      "cache": false
    },
    "package": {
      "cache": false
    },
    "test": {
      "cache": false,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "deploy": {
      "cache": false
    }
  }
}
