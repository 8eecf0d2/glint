{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.build/**/*",
      "!{projectRoot}/.swiftpm/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/.wrangler/**/*"
    ],
    "production": [
      "default"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "dev": {
      "cache": false
    },
    "package": {
      "cache": false
    }
  }
}
