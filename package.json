{
  "name": "glint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "applications/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "fixtures:spectacle": "node tools/spectacle-oracle/generate-fixtures.mjs",
    "dev:desktop": "nx run glint-desktop:dev",
    "icon:desktop": "bash scripts/compile-desktop-icon.sh applications/glint-desktop/Resources/IconComposer",
    "package:desktop": "nx run glint-desktop:package",
    "release:desktop": "bash scripts/package-release.sh",
    "dev:site": "nx run glint-site:dev",
    "graph": "nx graph",
    "check:site:deployment": "nx run glint-site:check-deployment",
    "preview:site:worker": "nx run glint-site:preview-worker",
    "deploy:site": "nx run glint-site:deploy",
    "dev:desktop:setup": "bash scripts/setup-development-signing.sh"
  },
  "devDependencies": {
    "nx": "^22.2.4",
    "typescript": "^6.0.3",
    "@types/node": "^22"
  }
}
