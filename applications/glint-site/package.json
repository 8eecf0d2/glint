{
  "name": "glint-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:worker:cloudflare": "npm run build",
    "check:deployment": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "develop:worker": "npm run build && wrangler dev --local --port 8787",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.78",
    "lucide-react": "^1.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "wrangler": "^4.130.0"
  }
}
