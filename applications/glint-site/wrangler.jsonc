{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "glint-site-production",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
