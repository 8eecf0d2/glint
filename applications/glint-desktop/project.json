{
  "name": "glint-desktop",
  "projectType": "application",
  "implicitDependencies": [
    "glint-core",
    "glint-brand"
  ],
  "tags": [
    "scope:desktop",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-release.mjs"
      },
      "inputs": [
        "production",
        "^production",
        "desktopRelease"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/package-desktop.sh"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/package-desktop.sh && open applications/glint-desktop/dist/Glint.app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift test --package-path libraries/glint-core && node --test scripts/release-policy.test.mjs"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/publish-release.mjs"
      }
    }
  }
}
